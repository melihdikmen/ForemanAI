# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM (OpenRouter, OpenAI-compatible API) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model is read from env so we can swap it without touching code.
LLM_MODEL=anthropic/claude-haiku-5.5
# Judge for evals; use a different (ideally stronger) model than LLM_MODEL.
JUDGE_MODEL=anthropic/claude-sonnet-5.5

# --- Embeddings ---
# Local multilingual model (good for Turkish). Dimension must match the pgvector column.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Database (PostgreSQL + pgvector, runs in Docker) ---
# These values are used by docker-compose to create the local database.
POSTGRES_USER=foreman
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=foremanai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full connection string the app uses (postgresql+psycopg = SQLAlchemy with the psycopg3 driver).
DATABASE_URL=postgresql+psycopg://foreman:change-me-local-only@localhost:5432/foremanai
# Read-only role for the assistant's tools (created by db/init/02-roles.sql).
DATABASE_URL_READONLY=postgresql+psycopg://foreman_reader:reader-local-only@localhost:5432/foremanai

# --- Observability (Langfuse, phase 7). Optional: leave empty to disable tracing. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Cloud deployment (phase 8). Used only by deploy steps (migrate/seed/index against the
# cloud DB); the running Cloud Run service reads DATABASE_URL* from Secret Manager instead. ---
CLOUD_DATABASE_URL=postgresql+psycopg://neondb_owner:xxx@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
CLOUD_DATABASE_URL_READONLY=postgresql+psycopg://foreman_reader:xxx@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
