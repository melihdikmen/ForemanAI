# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM (OpenRouter, OpenAI-compatible API) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model is read from env so we can swap it without touching code.
LLM_MODEL=anthropic/claude-haiku-5.5

# --- Embeddings ---
# Local multilingual model (good for Turkish). Dimension must match the pgvector column.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Database (PostgreSQL + pgvector, runs in Docker) ---
# These values are used by docker-compose to create the local database.
POSTGRES_USER=foreman
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=foremanai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full connection string the app uses (postgresql+psycopg = SQLAlchemy with the psycopg3 driver).
DATABASE_URL=postgresql+psycopg://foreman:change-me-local-only@localhost:5432/foremanai

# --- Observability (Langfuse) — added in a later phase, optional for now ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
